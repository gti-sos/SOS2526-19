{
  "info": {
    "_postman_id": "529ded79-012c-4da3-b227-5bcac2466f41",
    "name": "JMJ Earthquakes API",
    "description": "Colección completa para probar la API de terremotos JMJ. El test es idempotente: el registro TestLand/2024-01-15 creado en 2.1 es eliminado en 5.1, y en el bloque 6 se verifica que ese registro ya no existe (sin tocar la colección general).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "52414959",
    "_collection_link": "https://go.postman.co/collection/52414959-529ded79-012c-4da3-b227-5bcac2466f41?source=collection_link"
  },
  "item": [
    {
      "name": "1. GET Colección",
      "item": [
        {
          "name": "1.1 GET /earthquakes → 200 OK (primera página)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Respuesta es un array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "pm.test(\"Array tiene como máximo 10 elementos (limit por defecto)\", function () {",
                  "    pm.expect(pm.response.json().length).to.be.at.most(10);",
                  "});",
                  "pm.test(\"Cada elemento tiene los campos del recurso\", function () {",
                  "    const data = pm.response.json();",
                  "    if (data.length > 0) {",
                  "        pm.expect(data[0]).to.have.property('country');",
                  "        pm.expect(data[0]).to.have.property('fromdate');",
                  "        pm.expect(data[0]).to.have.property('severity');",
                  "    }",
                  "});",
                  "pm.test(\"Los elementos no contienen '_id'\", function () {",
                  "    pm.response.json().forEach(item => pm.expect(item).to.not.have.property('_id'));",
                  "});",
                  "pm.globals.set('firstPageSize', pm.response.json().length);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}{{BASE_JMJ}}?page=1",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "earthquakes"],
              "query": [
                { "key": "page", "value": "1" }
              ]
            },
            "description": "Obtiene la primera página con limit por defecto (10)."
          },
          "response": []
        },
        {
          "name": "1.2 GET /earthquakes → 200 OK (paginación página 2 tiene datos distintos)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Respuesta es un array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "pm.test(\"La página 2 devuelve datos (hay más de 10 registros en la BD)\", function () {",
                  "    pm.expect(pm.response.json().length).to.be.above(0);",
                  "});",
                  "pm.test(\"El primer elemento de página 2 tiene los campos esperados\", function () {",
                  "    const data = pm.response.json();",
                  "    if (data.length > 0) {",
                  "        pm.expect(data[0]).to.have.property('country');",
                  "        pm.expect(data[0]).to.have.property('fromdate');",
                  "        pm.expect(data[0]).to.have.property('severity');",
                  "    }",
