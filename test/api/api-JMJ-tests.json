          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}{{BASE_JMJ}}?page=2",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "earthquakes"],
              "query": [
                { "key": "page", "value": "2" }
