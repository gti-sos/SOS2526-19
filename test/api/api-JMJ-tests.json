        {
          "name": "4.4 PUT /earthquakes/:country/:date → 409 Conflict (country+fromdate ya existe en otro registro)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const baseUrl = pm.environment.get('BASE_URL');",
                  "const baseJmj = pm.environment.get('BASE_JMJ');",
                  "pm.sendRequest({",
                  "    url: baseUrl + baseJmj,",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "            country: 'TestLand2',",
