        {
          "name": "0.1 Load Initial Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201 or 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 200]);",
                  "});",
                  "pm.test(\"Response has count\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property('count');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}{{BASE_JMJ}}/loadInitialData",
              "host": [
                "{{BASE_URL}}{{BASE_JMJ}}"
              ],
              "path": [
                "loadInitialData"
              ]
            },
            "description": "Carga los datos iniciales del Excel en la DB en memoria."
          },
          "response": []
        },
        {
