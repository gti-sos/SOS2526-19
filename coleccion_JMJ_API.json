    {
      "name": "1. GET Colección",
      "item": [
        {
          "name": "1.1 GET /earthquakes → 200 OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Respuesta es un array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "// Guardamos el primer id para pruebas posteriores",
                  "var arr = pm.response.json();",
                  "if (arr.length > 0) {",
                  "    pm.collectionVariables.set('EXISTING_ID', arr[0].id);",
                  "    pm.collectionVariables.set('EXISTING_COUNTRY', arr[0].country);",
                  "    pm.collectionVariables.set('EXISTING_FROMDATE', arr[0].fromdate);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}{{BASE_JMJ}}",
              "host": [
                "{{BASE_URL}}{{BASE_JMJ}}"
              ]
            },
            "description": "Obtiene todos los terremotos. Guarda el primer id/country/fromdate para pruebas."
          },
          "response": []
        }
      ]
    },
