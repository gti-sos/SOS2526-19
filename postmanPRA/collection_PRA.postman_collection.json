    {
      "name": "Get recurso unico",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response matches country and from_date from URL\", function () {\r",
              "\r",
              "    const jsonData = pm.response.json();\r",
              "\r",
              "    const path = pm.request.url.path;\r",
              "    const country = path[path.length - 2];\r",
              "    const fromDate = parseInt(path[path.length - 1]);\r",
              "\r",
              "    pm.expect(jsonData).to.have.property(\"country\");\r",
              "    pm.expect(jsonData).to.have.property(\"from_date\");\r",
              "\r",
              "    pm.expect(jsonData.country).to.eql(country);\r",
              "    pm.expect(jsonData.from_date).to.eql(fromDate);\r",
              "\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
